---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bodyClass?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  image,
  noindex = false,
  bodyClass = '',
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const desc = description || site.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image || 'https://z-cdn.chatglm.cn/image-search-mcp/images-ppt/b418ec042f95.jpeg';

// Structured data پیش‌فرض: Organization + WebSite
const defaultLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    alternateName: site.nameEn,
    url: Astro.site?.href,
    logo: new URL('favicon.svg', Astro.site).href,
    description: site.description,
    telephone: site.phone,
    email: site.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address,
      addressCountry: 'IR',
    },
    sameAs: site.social.map((s) => s.href).filter((h) => h && h !== '#'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: Astro.site?.href,
    inLanguage: 'fa-IR',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${Astro.site?.href}products?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];
const ldItems = jsonLd
  ? Array.isArray(jsonLd)
    ? [...defaultLd, ...jsonLd]
    : [...defaultLd, jsonLd]
  : defaultLd;
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0e2240" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Font preconnect -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://z-cdn.chatglm.cn" />

    <!-- Structured Data -->
    {ldItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">رفتن به محتوای اصلی</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    right: 16px;
    z-index: 9999;
    background: var(--brand-navy);
    color: #fff;
    padding: 10px 18px;
    border-radius: 0 0 var(--r-sm) var(--r-sm);
    font-weight: 700;
    transition: top .2s;
  }
  .skip-link:focus { top: 0; }
</style>
