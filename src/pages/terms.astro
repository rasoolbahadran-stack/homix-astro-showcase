---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const sections = [
  {
    title: '۱. کلیات',
    body: 'این فروشگاه یک نمونه‌کار نمایشی (Demo) برای ارائه توانمندی طراحی و توسعه فروشگاه اینترنتی است. تمامی محصولات، قیمت‌ها، برندها و اطلاعات نمایش‌داده‌شده صرفاً جهت نمایش هستند و هیچ سفارش، پرداخت یا تحویل واقعی انجام نمی‌گیرد. استفاده از این وب‌سایت به‌منزله پذیرش شرایط زیر است.',
  },
  {
    title: '۲. حساب کاربری',
    body: 'در نسخه نمایشی، ثبت‌نام و ورود کاربر فعال نیست. هیچ اطلاعات حساب کاربری جمع‌آوری یا ذخیره نمی‌شود. در نسخه عملیاتی آینده، حساب کاربری برای پیگیری سفارش‌ها و خدمات پس از فروش فعال خواهد شد و شرایط مربوط به آن در همین صفحه به‌روزرسانی می‌شود.',
  },
  {
    title: '۳. سفارش و پرداخت',
    body: 'افزودن کالا به سبد خرید، تغییر تعداد و محاسبه مجموع سفارش به‌صورت نمایشی و در مرورگر شما انجام می‌شود. دکمه «ادامه فرآیند خرید» سفارش را ثبت نمی‌کند و هیچ پرداختی انجام نمی‌گیرد. این قابلیت‌ها صرفاً برای نمایش تجربه کاربری فروشگاه پیاده‌سازی شده‌اند.',
  },
  {
    title: '۴. قیمت‌ها و موجودی',
    body: 'قیمت‌ها و وضعیت موجودی نمایش‌داده‌شده در این نسونه‌کار نمونه هستند و ممکن است با قیمت‌ها و موجودی واقعی محصولات تطابق نداشته باشند. هیچ تعهدی نسبت به correctness این اطلاعات وجود ندارد.',
  },
  {
    title: '۵. مالکیت معنوی',
    body: 'طراحی، کدها و محتوای متنی این وب‌سایت متعلق به توسعه‌دهنده نمونه‌کار است. تصاویر محصولات از منابع عمومی بازنشر شده‌اند و نام برندها متعلق به صاحبان مربوطه است و در این نمونه‌کار صرفاً برای نمایش استفاده شده‌اند.',
  },
  {
    title: '۶. حریم خصوصی',
    body: 'این نسخه نمایشی هیچ داده شخصی را جمع‌آوری نمی‌کند. تنها اطلاعاتی که در مرورگر شما ذخیره می‌شود، محتوای سبد خرید (در localStorage) است که با پاک‌کردن مرورگر حذف می‌شود. در نسخه عملیاتی، سیاست حریم خصوصی کامل در همین صفحه ارائه خواهد شد.',
  },
  {
    title: '۷. تغییر شرایط',
    body: 'توسعه‌دهنده حق تغییر، به‌روزرسانی یا حذف بخش‌هایی از این نمونه‌کار را بدون اطلاع قبلی برای خود محفوظ می‌دارد.',
  },
];
---
<Layout
  title="قوانین و شرایط"
  description="قوانین و شرایط استفاده از فروشگاه نمونه‌کار هومیکس — شرح کامل شرایط استفاده، حریم خصوصی و مالکیت معنوی."
>
  <div class="container terms-wrap">
    <Breadcrumb items={[{ label: 'صفحه اصلی', href: '' }, { label: 'قوانین و شرایط' }]} />
    <div class="terms-head">
      <h1>قوانین و شرایط استفاده</h1>
      <p class="terms-updated">آخرین به‌روزرسانی: آذر ۱۴۰۳</p>
    </div>

    <div class="terms-intro">
      <p>
        استفاده از وب‌سایت هومیکس به‌منزله پذیرش قوانین و شرایط زیر است. لطفاً پیش از استفاده،
        این متن را به‌دقت مطالعه کنید. از آنجا که هومیکس یک نمونه‌کار نمایشی است، شرایط زیر
        متناسب با ماهیت نمایشی تنظیم شده‌اند.
      </p>
    </div>

    <div class="terms-body">
      {sections.map((s) => (
        <section class="term-section">
          <h2>{s.title}</h2>
          <p>{s.body}</p>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .terms-wrap { padding-block: 24px 60px; max-width: 820px; }
  .terms-wrap :global(.breadcrumb) { margin-bottom: 20px; }
  .terms-head h1 { font-size: clamp(1.7rem, 3.5vw, 2.3rem); }
  .terms-updated { color: var(--text-soft); font-size: .85rem; margin-top: 6px; }
  .terms-intro { background: var(--surface-2); border-radius: var(--r-md); padding: 20px 24px; margin: 20px 0 28px; border-right: 3px solid var(--brand-gold); }
  .terms-intro p { line-height: 1.9; }
  .terms-body { display: flex; flex-direction: column; gap: 24px; }
  .term-section h2 { font-size: 1.15rem; margin-bottom: 8px; color: var(--brand-navy); }
  .term-section p { line-height: 1.9; color: var(--text-muted); }
</style>
