---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data';
import { href } from '../lib/nav';
---
<Layout title="سبد خرید" description="سبد خرید فروشگاه هومیکس — مرور اقلام انتخاب‌شده، تغییر تعداد و محاسبه مجموع سفارش." noindex>
  <div class="container cart-wrap">
    <Breadcrumb items={[{ label: 'صفحه اصلی', href: '' }, { label: 'سبد خرید' }]} />
    <h1 class="cart-title">سبد خرید شما</h1>

    <div id="cart-root">
      <!-- حالت خالی -->
      <div class="cart-empty" id="cart-empty">
        <div class="ce-ic"><Icon name="cart" size={56} /></div>
        <h2>سبد خرید شما خالی است</h2>
        <p>هنوز محصولی به سبد خرید اضافه نکرده‌اید. می‌توانید از میان محصولات متنوع هومیکس انتخاب کنید.</p>
        <a href={href('products')} class="btn btn-primary btn-lg"><Icon name="arrow-left" size={18} /> شروع خرید</a>
      </div>

      <!-- محتوای سبد -->
      <div id="cart-content" style="display:none">
        <div class="cart-layout">
          <div class="cart-table-wrap">
            <table class="cart-table">
              <thead>
                <tr>
                  <th>محصول</th>
                  <th>قیمت واحد</th>
                  <th>تعداد</th>
                  <th>مجموع</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="cart-rows"></tbody>
            </table>
            <a href={href('products')} class="continue-link"><Icon name="arrow-left" size={16} /> ادامه خرید</a>
          </div>

          <aside class="cart-summary">
            <h2>خلاصه سفارش</h2>
            <div class="summary-row">
              <span>تعداد اقلام</span>
              <strong id="cart-items-count">۰</strong>
            </div>
            <div class="summary-row">
              <span>جمع کالا</span>
              <strong><span id="cart-subtotal">۰</span> <span class="toman">تومان</span></strong>
            </div>
            <div class="summary-row">
              <span>هزینه ارسال</span>
              <strong id="cart-shipping">رایگان</strong>
            </div>
            <hr class="divider" />
            <div class="summary-row total">
              <span>مبلغ قابل پرداخت</span>
              <strong><span id="cart-total">۰</span> <span class="toman">تومان</span></strong>
            </div>

            <div class="summary-trust">
              <span><Icon name="shield" size={16} /> پرداخت امن</span>
              <span><Icon name="truck" size={16} /> ارسال سریع</span>
            </div>

            <button class="btn btn-primary btn-lg btn-block checkout-btn" id="checkout-btn">
              <Icon name="check" size={20} /> ادامه فرآیند خرید
            </button>
            <p class="cart-note">
              <Icon name="sparkles" size={14} /> {site.demoNote} دکمه پرداخت سفارش را ثبت نمی‌کند.
            </p>
          </aside>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .cart-wrap { padding-block: 24px 60px; }
  .cart-title { font-size: clamp(1.6rem, 3vw, 2.1rem); margin: 14px 0 28px; }

  /* empty */
  .cart-empty { text-align: center; padding: 60px 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); }
  .ce-ic { width: 96px; height: 96px; margin: 0 auto 18px; border-radius: 50%; background: var(--surface-2); color: var(--brand-navy); display: grid; place-items: center; }
  .cart-empty h2 { margin-bottom: 8px; }
  .cart-empty p { margin-bottom: 22px; max-width: 40ch; margin-inline: auto; }

  /* layout */
  .cart-layout { display: grid; grid-template-columns: 1fr 340px; gap: 24px; align-items: flex-start; }
  .cart-table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 8px 20px 20px; }
  .cart-table { width: 100%; border-collapse: collapse; }
  .cart-table thead th { padding: 16px 8px; border-bottom: 2px solid var(--border); text-align: right; font-size: .82rem; color: var(--text-muted); font-weight: 700; }
  .cart-table tbody td { padding: 16px 8px; border-bottom: 1px solid var(--border-soft); vertical-align: middle; font-size: .9rem; }
  .cart-table tbody tr:last-child td { border-bottom: none; }
  .cart-prod { display: flex; align-items: center; gap: 12px; }
  .cart-prod img { width: 64px; height: 64px; border-radius: var(--r-sm); object-fit: cover; border: 1px solid var(--border); flex-shrink: 0; }
  .cart-prod span { font-size: .86rem; font-weight: 600; color: var(--text); display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cart-prod:hover span { color: var(--brand-gold-700); }
  .toman { font-size: .76rem; color: var(--text-soft); font-weight: 600; }
  .cart-subtotal { font-weight: 800; color: var(--brand-navy); }

  .qty-stepper { display: inline-flex; align-items: center; border: 1.5px solid var(--border); border-radius: var(--r-sm); overflow: hidden; }
  .qty-stepper button { width: 32px; height: 34px; font-size: 1.1rem; color: var(--brand-navy); }
  .qty-stepper button:hover { background: var(--surface-2); }
  .qty-stepper span { min-width: 34px; text-align: center; font-weight: 700; }
  .cart-remove { color: var(--brand-coral-600); display: grid; place-items: center; width: 34px; height: 34px; border-radius: var(--r-sm); transition: background .2s; }
  .cart-remove:hover { background: rgba(255,107,74,.1); }

  .continue-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 18px; color: var(--brand-navy-600); font-weight: 700; font-size: .88rem; }
  .continue-link:hover { color: var(--brand-gold-700); }

  /* summary */
  .cart-summary { position: sticky; top: calc(var(--header-h) + 16px); background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 24px; }
  .cart-summary h2 { font-size: 1.15rem; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }
  .summary-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; font-size: .92rem; color: var(--text-muted); }
  .summary-row strong { color: var(--text); font-weight: 700; }
  .summary-row.total { font-size: 1.1rem; }
  .summary-row.total strong { color: var(--brand-navy); font-weight: 800; font-size: 1.2rem; }
  .summary-trust { display: flex; gap: 16px; margin: 16px 0; padding: 12px; background: var(--surface-2); border-radius: var(--r-sm); }
  .summary-trust span { display: inline-flex; align-items: center; gap: 6px; font-size: .8rem; color: var(--text-muted); }
  .summary-trust :global(svg) { color: var(--brand-teal); }
  .checkout-btn { margin-top: 6px; }
  .cart-note { display: flex; align-items: flex-start; gap: 6px; font-size: .78rem; color: var(--text-soft); margin-top: 12px; line-height: 1.6; }
  .cart-note :global(svg) { color: var(--brand-gold); flex-shrink: 0; margin-top: 2px; }

  @media (max-width: 880px) {
    .cart-layout { grid-template-columns: 1fr; }
    .cart-summary { position: static; }
    /* جدول کارتی در موبایل */
    .cart-table thead { display: none; }
    .cart-table, .cart-table tbody, .cart-table tr, .cart-table td { display: block; width: 100%; }
    .cart-table tr { border: 1px solid var(--border); border-radius: var(--r-md); margin-bottom: 12px; padding: 8px; }
    .cart-table td { display: flex; justify-content: space-between; align-items: center; border: none; padding: 8px 4px; }
    .cart-table td::before { content: attr(data-label); color: var(--text-soft); font-size: .8rem; font-weight: 600; }
    .cart-table td[data-label="محصول"] { flex-direction: column; align-items: flex-start; }
    .cart-table td[data-label="محصول"]::before { margin-bottom: 6px; }
  }
</style>

<script>
  // دکمه پرداخت نمونه — فقط پیام نمایشی
  document.getElementById('checkout-btn')?.addEventListener('click', async () => {
    const { toast } = await import('../scripts/app.ts');
    toast('این فروشگاه نمونه‌کار است؛ پرداخت واقعی انجام نمی‌شود', 'info');
  });
</script>
