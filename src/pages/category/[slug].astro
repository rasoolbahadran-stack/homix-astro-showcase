---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import { categories, productsByCategory, brands, categoryBySlug } from '../../data';
import { toFa } from '../../lib/format';
import { href } from '../../lib/nav';

export function getStaticPaths() {
  return categories.map((c) => ({
    params: { slug: c.slug },
    props: { category: c, items: productsByCategory(c.slug) },
  }));
}

const { category, items } = Astro.props;
if (!category) return Astro.redirect('/404');
const catBrands = brands.filter((b) => items.some((p) => p.brandId === b.id));
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: category.name,
  itemListElement: items.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(href(`products/${p.slug}`), Astro.site).href,
    name: p.name,
  })),
};
---
<Layout
  title={category.name}
  description={`${category.name} — ${category.blurb} خرید آنلاین از فروشگاه هومیکس با ضمانت اصالت کالا و ارسال سراسری.`}
  jsonLd={ld}
>
  <!-- هدر دسته -->
  <section class="cat-hero">
    <div class="container cat-hero-inner">
      <Breadcrumb items={[{ label: 'صفحه اصلی', href: '' }, { label: 'محصولات', href: 'products' }, { label: category.name }]} />
      <div class="cat-hero-grid">
        <div class="cat-hero-text reveal">
          <span class="cat-ic"><Icon name={category.icon} size={30} /></span>
          <div>
            <h1>{category.name}</h1>
            <p>{category.blurb}</p>
            <div class="cat-meta-row">
              <span><Icon name="list" size={15} /> {toFa(items.length)} محصول</span>
              <span><Icon name="shield" size={15} /> ضمانت اصالت</span>
              <span><Icon name="truck" size={15} /> ارسال سراسری</span>
            </div>
          </div>
        </div>
        <div class="cat-hero-img reveal">
          <img src={category.image} alt={category.name} width="320" height="240" />
        </div>
      </div>
    </div>
  </section>

  <div class="container shop-wrap" data-shop data-hide-cat="true">
    <!-- فیلتر (بدون دسته‌بندی، چون صفحه خود دسته است) -->
    <aside class="filters" id="filters">
      <div class="filters-head">
        <h2><Icon name="filter" size={18} /> فیلترها</h2>
        <button class="clear-btn" data-clear>پاک کردن</button>
      </div>
      <div class="filter-block">
        <label class="search-field">
          <Icon name="search" size={18} />
          <input type="search" data-search placeholder="جستجو در این دسته…" aria-label="جستجو" />
        </label>
      </div>
      {catBrands.length > 0 && (
        <div class="filter-block">
          <h3>برند</h3>
          <div class="check-list">
            {catBrands.map((b) => (
              <label class="check">
                <input type="checkbox" data-f-brand={b.slug} data-label={b.name} value={b.slug} />
                <span>{b.name}</span>
              </label>
            ))}
          </div>
        </div>
      )}
      <div class="filter-block">
        <h3>محدوده قیمت (تومان)</h3>
        <div class="price-range">
          <input type="number" data-f-min placeholder="از" min="0" aria-label="حداقل قیمت" />
          <span>—</span>
          <input type="number" data-f-max placeholder="تا" min="0" aria-label="حداکثر قیمت" />
        </div>
      </div>
      <div class="filter-block">
        <label class="check toggle">
          <input type="checkbox" data-f-discount />
          <span><Icon name="percent" size={14} /> فقط تخفیف‌دارها</span>
        </label>
      </div>
    </aside>

    <div class="shop-main">
      <div class="toolbar">
        <button class="filter-toggle" id="filter-toggle"><Icon name="filter" size={18} /> فیلترها</button>
        <div class="active-tags" data-active-tags></div>
        <div class="sort-wrap">
          <label for="sort">مرتب‌سازی:</label>
          <select id="sort" data-sort>
            <option value="bestseller">پرفروش‌ترین</option>
            <option value="newest">جدیدترین</option>
            <option value="price-asc">ارزان‌ترین</option>
            <option value="price-desc">گران‌ترین</option>
            <option value="rating">پرامتیازترین</option>
          </select>
        </div>
      </div>

      <div class="prod-grid shop-grid">
        {items.map((p) => (
          <div
            data-product-card
            data-name={p.name}
            data-cat={p.categorySlug}
            data-brand={p.brandId}
            data-price={p.price}
            data-discount={p.oldPrice ? 'true' : 'false'}
            data-created={p.createdAt}
            data-sold={p.soldCount}
            data-rating={p.rating}
          >
            <ProductCard product={p} />
          </div>
        ))}
      </div>

      <div class="shop-empty" data-empty style="display:none">
        <Icon name="search" size={48} />
        <h3>محصولی یافت نشد</h3>
        <p>فیلترها را تغییر دهید یا پاک کنید.</p>
        <button class="btn btn-primary" data-clear>پاک کردن فیلترها</button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .cat-hero { background: linear-gradient(135deg, var(--brand-navy-800), var(--brand-navy-600)); color: #fff; padding-block: 24px 36px; }
  .cat-hero-inner :global(.breadcrumb) { margin-bottom: 18px; }
  .cat-hero-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 28px; align-items: center; }
  .cat-hero-text { display: flex; gap: 18px; align-items: flex-start; }
  .cat-ic { flex-shrink: 0; width: 64px; height: 64px; border-radius: var(--r-md); background: rgba(245,166,35,.18); color: var(--brand-gold); display: grid; place-items: center; }
  .cat-hero-text h1 { color: #fff; font-size: clamp(1.5rem, 3vw, 2rem); }
  .cat-hero-text p { color: #b9c4d8; margin: 8px 0 14px; max-width: 50ch; }
  .cat-meta-row { display: flex; flex-wrap: wrap; gap: 18px; font-size: .84rem; color: #cdd7e8; }
  .cat-meta-row span { display: inline-flex; align-items: center; gap: 6px; }
  .cat-hero-img img { border-radius: var(--r-lg); box-shadow: var(--shadow-navy); width: 100%; object-fit: cover; aspect-ratio: 4/3; }

  .shop-wrap { display: grid; grid-template-columns: 260px 1fr; gap: 28px; padding-block: 32px; align-items: flex-start; }
  .filters { position: sticky; top: calc(var(--header-h) + 16px); background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 20px; }
  .filters-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }
  .filters-head h2 { font-size: 1rem; display: inline-flex; align-items: center; gap: 8px; }
  .clear-btn { color: var(--brand-coral-600); font-size: .82rem; font-weight: 700; }
  .filter-block { padding-block: 14px; border-bottom: 1px solid var(--border-soft); }
  .filter-block:last-child { border-bottom: none; }
  .filter-block h3 { font-size: .85rem; margin-bottom: 10px; }
  .search-field { display: flex; align-items: center; gap: 8px; background: var(--surface-2); border: 1.5px solid var(--border); border-radius: var(--r-sm); padding: 8px 12px; }
  .search-field input { border: none; outline: none; background: none; flex: 1; min-width: 0; }
  .check-list { display: flex; flex-direction: column; gap: 6px; }
  .check { display: flex; align-items: center; gap: 8px; font-size: .86rem; color: var(--text-muted); cursor: pointer; }
  .check input { accent-color: var(--brand-gold); width: 16px; height: 16px; }
  .check.toggle span { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--text); }
  .price-range { display: flex; align-items: center; gap: 8px; }
  .price-range input { width: 100%; padding: 8px 10px; border: 1.5px solid var(--border); border-radius: var(--r-sm); font-size: .85rem; outline: none; }

  .shop-main { min-width: 0; }
  .toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
  .filter-toggle { display: none; align-items: center; gap: 8px; padding: 9px 16px; border: 1.5px solid var(--border); border-radius: var(--r-pill); background: var(--surface); font-weight: 600; font-size: .9rem; }
  .active-tags { display: flex; flex-wrap: wrap; gap: 8px; flex: 1; }
  .active-tag { background: rgba(245,166,35,.12); color: var(--brand-gold-700); font-size: .78rem; font-weight: 600; padding: 4px 12px; border-radius: var(--r-pill); }
  .sort-wrap { display: flex; align-items: center; gap: 8px; margin-right: auto; }
  .sort-wrap label { font-size: .85rem; color: var(--text-muted); white-space: nowrap; }
  .sort-wrap select { padding: 9px 14px; border: 1.5px solid var(--border); border-radius: var(--r-sm); background: var(--surface); font-size: .88rem; cursor: pointer; }

  .shop-grid { grid-template-columns: repeat(3, 1fr); }
  .shop-empty { text-align: center; padding: 60px 20px; color: var(--text-muted); }
  .shop-empty :global(svg) { color: var(--text-soft); margin: 0 auto 14px; }

  @media (max-width: 980px) {
    .cat-hero-grid { grid-template-columns: 1fr; }
    .cat-hero-img { display: none; }
    .shop-wrap { grid-template-columns: 1fr; }
    .filters { position: fixed; top: 0; right: -100%; width: min(320px, 86vw); height: 100vh; z-index: 300; border-radius: 0; overflow-y: auto; transition: right .3s; padding-top: 60px; }
    .filters.open { right: 0; box-shadow: -10px 0 40px rgba(14,34,64,.2); }
    .filter-toggle { display: inline-flex; }
    .shop-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .shop-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import '../../scripts/shop.ts';
  const toggle = document.getElementById('filter-toggle');
  const filters = document.getElementById('filters');
  toggle?.addEventListener('click', () => filters?.classList.toggle('open'));
  document.addEventListener('click', (e) => {
    if (!filters?.classList.contains('open')) return;
    if (!filters.contains(e.target as Node) && e.target !== toggle) filters?.classList.remove('open');
  });
</script>
